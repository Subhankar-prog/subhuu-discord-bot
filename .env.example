# Copy this file to ".env" and fill in your real values. Never share your .env file.

# From https://discord.com/developers/applications -> Your App -> Bot -> Token
DISCORD_TOKEN=

# From https://discord.com/developers/applications -> Your App -> General Information -> Application ID
CLIENT_ID=

# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID
# Used so slash commands appear instantly in YOUR server (global commands take up to 1hr to update)
GUILD_ID=

# Free key from https://aistudio.google.com/app/apikey (used for the /ask AI chat command)
GEMINI_API_KEY=

# Text channel ID where welcome messages should be posted (right-click channel -> Copy Channel ID)
WELCOME_CHANNEL_ID=
